# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Google AI Studio key for the "Ask Amar" chatbot (never commit the real key)
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# "Ask Amar" lead hand-off (Resend, https://resend.com)
RESEND_API_KEY=
# Where leads are emailed (defaults to Amar's address in src/lib/content.ts)
# LEAD_TO=amarabdulrehman123@gmail.com
# Sender. Set this once amarabdurrehman.me is verified in Resend; that also turns on
# the visitor's confirmation email. Until then Resend's test sender is used.
# LEAD_FROM=Ask Amar <hello@amarabdurrehman.me>
